{
  "name": "mustard-seed-miniprogram",
  "version": "1.0.0",
  "private": true,
  "description": "芥菜种子 · 微信小程序版（Taro）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:weapp": "taro build --type weapp",
    "lint": "eslint --ext .ts,.tsx src/",
    "clean": "rimraf dist",
    "postinstall": "weapp-tw patch"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.29.7",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/webpack-env": "^1.18.4",
    "autoprefixer": "^10.4.19",
    "babel-preset-taro": "4.2.1",
    "eslint": "^8.57.0",
    "postcss": "^8.4.38",
    "rimraf": "^5.0.7",
    "sass": "^1.77.8",
    "sharp": "^0.35.4",
    "tailwindcss": "3.4.17",
    "typescript": "^5.4.5",
    "weapp-tailwindcss": "^4.1.0",
    "webpack": "^5.91.0"
  }
}
